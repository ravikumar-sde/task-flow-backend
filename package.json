{
  "name": "trellobackend",
  "version": "1.0.0",
  "description": "Trello Backend API with Clean Architecture",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test test/unit/*.test.cjs",
    "test:watch": "node --test --watch test/unit/*.test.cjs",
    "test:coverage": "node --test --experimental-test-coverage test/unit/*.test.cjs",
    "test:integration": "node --test test/integration/*.test.cjs",
    "lint": "echo \"⚠️  ESLint not configured. Run: npm install --save-dev eslint\" && exit 0",
    "lint:fix": "echo \"⚠️  ESLint not configured\" && exit 0",
    "format": "echo \"⚠️  Prettier not configured. Run: npm install --save-dev prettier\" && exit 0",
    "format:check": "echo \"⚠️  Prettier not configured\" && exit 0"
  },
  "keywords": [
    "trello",
    "express",
    "mongodb",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "nodemailer": "^7.0.11",
    "openai": "^6.10.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
