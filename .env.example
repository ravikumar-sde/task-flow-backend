# Application configuration. Supply runtime values in your own environment.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/trello_db
JWT_SECRET=<jwt-secret>
JWT_EXPIRE=7d
CORS_ORIGIN=https://frontend.example.com
FRONTEND_URL=https://frontend.example.com

# Recovery requires a trusted HTTPS frontend page, without query or fragment.
# Missing URL or SendGrid settings suppress delivery with the uniform response.
PASSWORD_RESET_PAGE_URL=https://frontend.example.com/reset-password
PASSWORD_RESET_EXPIRY_MINUTES=15
PASSWORD_RESET_EMAIL_LIMIT=5
PASSWORD_RESET_IP_LIMIT=20
SENDGRID_API_KEY=<sendgrid-api-key>
EMAIL_USER=<verified-sender-email>
EMAIL_FROM_NAME=Task Flow

OPENAI_API_KEY=<openai-api-key>
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>
